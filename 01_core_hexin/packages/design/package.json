{
  "name": "@shop/design",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "npm run typecheck",
    "lint": "npm run typecheck",
    "storybook": "storybook dev --config-dir .storybook --port 6006",
    "storybook:build": "storybook build --config-dir .storybook",
    "test": "vitest run --exclude src/ResourceState.component.test.tsx --exclude src/Dialog.component.test.tsx --exclude src/RouteFallback.component.test.tsx --passWithNoTests",
    "test:component": "vitest run src/ResourceState.component.test.tsx src/Dialog.component.test.tsx src/RouteFallback.component.test.tsx",
    "typecheck": "tsc --noEmit"
  },
  "exports": {
    ".": "./src/index.ts",
    "./access-denied": "./src/AccessDenied.tsx",
    "./base.css": "./src/base.css",
    "./components.css": "./src/components.css",
    "./console": "./src/console-ui/index.ts",
    "./console.css": "./src/console.css",
    "./tokens.css": "./src/tokens.css",
    "./workspace.css": "./src/workspace.css",
    "./shell.css": "./src/shell.css",
    "./tokens.json": "./src/tokens.json",
    "./mobile-platforms.json": "./src/mobile-platforms.json",
    "./brand/*": "./src/brand/*"
  },
  "types": "./src/index.ts",
  "dependencies": {
    "@tanstack/react-table": "9.1.2",
    "lucide-react": "0.546.0",
    "react": "19.2.8",
    "react-aria-components": "1.20.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@storybook/addon-a11y": "10.5.10",
    "@storybook/react-vite": "10.5.10",
    "@types/react": "19.2.14",
    "storybook": "10.5.10",
    "typescript": "5.9.3",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  },
  "optionalDependencies": {
    "@oxc-parser/binding-linux-x64-gnu": "0.127.0",
    "@oxc-parser/binding-linux-x64-musl": "0.127.0",
    "@oxc-resolver/binding-linux-x64-gnu": "11.21.2",
    "@oxc-resolver/binding-linux-x64-musl": "11.21.2"
  }
}
