# 仅供本地开发参考。所有生产密钥由托管平台密钥库注入。
# 生产环境必须设置 APP_ENV=production、AUTH_MODE=membership。
APP_ENV=development
AUTH_MODE=membership
# 手机注册开关；只有阿里云短信签名、模板和凭据全部就绪后才启用。
SELF_REGISTRATION_ENABLED=false
# 账号密码注册独立开关；只创建持有企业邀请码的普通员工会员。
USERNAME_REGISTRATION_ENABLED=false
# 微信新会员注册独立开关；注册必须同时持有微信一次性凭证和企业邀请码。
WECHAT_REGISTRATION_ENABLED=false
# 开发/测试可使用 debug；生产使用 aliyun 且永不返回调试验证码。
SMS_PROVIDER=debug
# 阿里云短信的签名和验证码模板必须先在控制台审核通过。
ALIYUN_SMS_SIGN_NAME=your-approved-sign-name
ALIYUN_SMS_TEMPLATE_CODE_VERIFICATION=SMS_your_approved_template_code
ALIYUN_SMS_REGION_ID=cn-hangzhou
ALIYUN_SMS_ENDPOINT=dysmsapi.aliyuncs.com
# ECS 生产优先挂载仅有 SendSms 权限的 RAM 角色，避免长期 AccessKey。
ALIYUN_SMS_ECS_RAM_ROLE=SmartWingSmsSenderRole
# 非 ECS 环境才使用独立 RAM 用户 AccessKey；不要使用阿里云主账号 AccessKey。
# ALIYUN_SMS_ACCESS_KEY_ID=server-only-access-key-id
# ALIYUN_SMS_ACCESS_KEY_SECRET=server-only-access-key-secret
DATABASE_URL=postgresql://user:password@127.0.0.1:55432/zhudatuan_registration
DATABASE_REGION=cn-hangzhou
PUBLIC_MALL_SLUG=zhudatuan
# Web 与微信小程序共用的商品媒体域名；对象同步完成并验证 CDN 后再启用。
PUBLIC_MEDIA_BASE_URL=https://media.zhudatuan.com
# 北京同地域核心读镜像。只允许回环/private HTTPS，绝不对公网暴露。
CORE_READ_CACHE_URL=http://127.0.0.1:3002
CORE_READ_CACHE_TOKEN=separate-long-random-internal-cache-token
# Tair 连接只由 core-read-cache 进程读取；优先使用同 VPC 内网地址与 TLS。
TAIR_HOST=your-tair-private-endpoint
TAIR_PORT=6379
TAIR_USERNAME=default
TAIR_PASSWORD=server-only-tair-password
TAIR_TLS_ENABLED=true
PII_ENCRYPTION_KEY=base64-encoded-32-byte-secret
SESSION_SIGNING_KEY=long-random-session-signing-secret
# 独立且稳定的身份检索密钥；轮换会话密钥时不得随之更换。
IDENTITY_LOOKUP_KEY=separate-long-random-identity-lookup-secret
# 与 SESSION_SIGNING_KEY 不同的、至少 32 字符的后台域签名密钥；生产必填。
ADMIN_SESSION_SIGNING_KEY=separate-long-random-admin-session-signing-secret
# 微信小程序身份通道。AppSecret 与独立会话密钥只允许放服务器密钥库。
WECHAT_MINIAPP_APP_ID=wx4df4137881a1d2bc
WECHAT_MINIAPP_APP_SECRET=server-only-wechat-app-secret
MINIAPP_SESSION_SIGNING_KEY=separate-long-random-miniapp-session-signing-secret
# 微信支付 API v3（普通商户直连模式）。私钥必须是 PKCS#8 PEM；dotenv
# 中可把换行写成字面量 \n。平台公钥可由平台证书安全提取为 SPKI PEM。
WECHAT_PAY_MCH_ID=your-direct-merchant-id
WECHAT_PAY_MERCHANT_SERIAL_NO=your-merchant-certificate-serial
WECHAT_PAY_MERCHANT_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nserver-only-pkcs8-key\n-----END PRIVATE KEY-----
WECHAT_PAY_API_V3_KEY=exactly-32-byte-api-v3-secret
WECHAT_PAY_PLATFORM_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\nwechat-pay-platform-key\n-----END PUBLIC KEY-----
WECHAT_PAY_PLATFORM_KEY_ID=your-platform-certificate-serial-or-public-key-id
WECHAT_PAY_NOTIFY_URL=https://zhudatuan.com/api/v1/payments/wechat/notify
# 本地演示才使用：APP_ENV=development 与 AUTH_MODE=development。
# 演示身份仍从数据库 Membership 解析，账号夹具不进入生产配置。
# 测试环境临时登录限流白名单：只接受精确 IP，到期必须在24小时内且带时区；不要提交真实 IP。
# TEST_LOGIN_RATE_LIMIT_BYPASS_IPS=203.0.113.10,2001:db8::10
# TEST_LOGIN_RATE_LIMIT_BYPASS_FROM=2026-08-12T00:00:00Z
# TEST_LOGIN_RATE_LIMIT_BYPASS_UNTIL=2026-08-13T00:00:00Z
