    "local:down": "docker compose --env-file 02_platform_pingtai/infrastructure/local/.env.local -f 02_platform_pingtai/infrastructure/local/docker-compose.yml down",
    "local:services": "node --env-file=02_platform_pingtai/infrastructure/local/.env.local 04_tools/tools/localinfra/src/Launch.mjs --import tsx 04_tools/tools/localinfra/src/Run.ts",
