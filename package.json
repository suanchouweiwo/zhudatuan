    "quality:canonical-hard-cut": "npm run check:cleaninstall && npm run check:supplychain && npm run check:generated && npm run check:errors && npm run check:requirements && npm run audit:architecture && npm run check:lines && npm run check:approved-ui && npm run check:identity-nodes && npm run typecheck && npm run check:migrations && npm run test:sql && npm run test:mvp && npm run test:unit && npm run test:contract && npm run test:integration && npm run test:adapters && npm run test:component && npm run test:e2e && npm run test:journey && npm run test:security && npm run test:performance && npm run build && npm run check:bundles && npm run audit:prod",
