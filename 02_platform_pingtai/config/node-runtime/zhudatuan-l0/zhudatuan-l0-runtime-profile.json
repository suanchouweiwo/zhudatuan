{
  "schema_version": "sfl.autonode-runtime-profile.v1",
  "profile_id": "zhudatuan-l0-opening",
  "environment": "production",
  "services": {
    "storefront": {},
    "catalog-api": {
      "DATABASE_API_CONNECTION_REF": "{node_token}/database/catalog-api",
      "DATABASE_API_ROLE": "zhudatuanidentityapi",
      "OBJECT_STORE_ENDPOINT": "https://127.0.0.1:{object_store_port}",
      "OBJECT_STORE_BEARER_TOKEN": "{env:AUTONODE_ZHUDUATUAN_OBJECT_STORE_TOKEN}",
      "SECRET_STORE_ENDPOINT": "https://127.0.0.1:8553",
      "SECRET_STORE_BEARER_TOKEN": "{env:AUTONODE_ZHUDUATUAN_CATALOG_SECRET_STORE_TOKEN}",
      "NODE_EXTRA_CA_CERTS": "/opt/zhudatuan/shared/tls/internal-ca.crt"
    },
    "web-api": {
      "PUBLIC_MALL_SLUG": "{public_slug}",
      "DATABASE_API_CONNECTION_REF": "{node_token}/database/web-api",
      "DATABASE_API_ROLE": "zhudatuanwebapi",
      "KMS_ENDPOINT": "https://127.0.0.1:8544",
      "KMS_BEARER_TOKEN": "{env:AUTONODE_ZHUDUATUAN_WEB_KMS_TOKEN}",
      "SECRET_STORE_ENDPOINT": "https://127.0.0.1:8553",
      "SECRET_STORE_BEARER_TOKEN": "{env:AUTONODE_ZHUDUATUAN_WEB_SECRET_STORE_TOKEN}",
      "NODE_EXTRA_CA_CERTS": "/opt/zhudatuan/shared/tls/internal-ca.crt"
    },
    "identity-api": {
      "DATABASE_API_CONNECTION_REF": "{node_token}/database/identity-api",
      "DATABASE_API_ROLE": "zhudatuanidentityapi",
      "SESSION_KEY_REF": "{node_token}/identity/session",
      "IDENTITY_KEY_REF": "{node_token}/identity/index",
      "WECHAT_APPLICATION_CONFIG_REF": "{node_token}/identity/wechat-applications",
      "WECHAT_IDENTITY_CONFIG_REF": "{node_token}/identity/wechat",
      "KMS_ENDPOINT": "https://127.0.0.1:8544",
      "KMS_BEARER_TOKEN": "{env:AUTONODE_ZHUDUATUAN_IDENTITY_KMS_TOKEN}",
      "OBJECT_STORE_ENDPOINT": "https://127.0.0.1:{object_store_port}",
      "OBJECT_STORE_BEARER_TOKEN": "{env:AUTONODE_ZHUDUATUAN_OBJECT_STORE_TOKEN}",
      "SECRET_STORE_ENDPOINT": "https://127.0.0.1:8553",
      "SECRET_STORE_BEARER_TOKEN": "{env:AUTONODE_ZHUDUATUAN_IDENTITY_SECRET_STORE_TOKEN}",
      "NODE_EXTRA_CA_CERTS": "/opt/zhudatuan/shared/tls/internal-ca.crt"
    },
    "purchase-api": {
      "DATABASE_API_CONNECTION_REF": "{node_token}/database/purchase-api",
      "DATABASE_API_ROLE": "zhudatuanpurchaseapi",
      "QUOTE_KEY_REF": "{node_token}/purchase/checkout/quote",
      "SECRET_STORE_ENDPOINT": "https://127.0.0.1:8553",
      "SECRET_STORE_BEARER_TOKEN": "{env:AUTONODE_ZHUDUATUAN_PURCHASE_SECRET_STORE_TOKEN}",
      "KMS_ENDPOINT": "https://127.0.0.1:8544",
      "KMS_BEARER_TOKEN": "{env:AUTONODE_ZHUDUATUAN_PURCHASE_KMS_TOKEN}",
      "WECHAT_APPLICATION_CONFIG_REF": "{node_token}/payment/wechat-applications",
      "WECHAT_PAYMENT_CONFIG_REF": "{node_token}/payment/wechat",
      "NODE_EXTRA_CA_CERTS": "/opt/zhudatuan/shared/tls/internal-ca.crt"
    },
    "payment-webhook-api": {
      "DATABASE_API_CONNECTION_REF": "{node_token}/database/payment-webhook-api",
      "DATABASE_API_ROLE": "zhudatuanpaymentwebhookapi",
      "SECRET_STORE_ENDPOINT": "https://127.0.0.1:8553",
      "SECRET_STORE_BEARER_TOKEN": "{env:AUTONODE_ZHUDUATUAN_WEBHOOK_SECRET_STORE_TOKEN}",
      "WECHAT_APPLICATION_CONFIG_REF": "{node_token}/payment/wechat-applications",
      "WECHAT_PAYMENT_CONFIG_REF": "{node_token}/payment/wechat",
      "NODE_EXTRA_CA_CERTS": "/opt/zhudatuan/shared/tls/internal-ca.crt"
    },
    "catalog-jobs": {
