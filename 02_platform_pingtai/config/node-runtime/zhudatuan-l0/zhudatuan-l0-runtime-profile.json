      "SECRET_STORE_ENDPOINT": "https://127.0.0.1:8553",
      "SECRET_STORE_BEARER_TOKEN": "{env:AUTONODE_ZHUDUATUAN_CATALOG_JOBS_SECRET_STORE_TOKEN}",
      "NODE_EXTRA_CA_CERTS": "/opt/zhudatuan/shared/tls/internal-ca.crt"
    },
    "payment-jobs": {
      "DATABASE_JOB_CONNECTION_REF": "{node_token}/database/payment-jobs",
      "DATABASE_JOB_ROLE": "shopjob",
      "JOB_WORKER_ID": "{node_slug}-payment-1",
      "SECRET_STORE_ENDPOINT": "https://127.0.0.1:8553",
      "SECRET_STORE_BEARER_TOKEN": "{env:AUTONODE_ZHUDUATUAN_PAYMENT_JOBS_SECRET_STORE_TOKEN}",
      "WECHAT_APPLICATION_CONFIG_REF": "{node_token}/payment/wechat-applications",
      "WECHAT_PAYMENT_CONFIG_REF": "{node_token}/payment/wechat",
      "NODE_EXTRA_CA_CERTS": "/opt/zhudatuan/shared/tls/internal-ca.crt"
    },
    "object-store": {
      "LOCAL_TLS_KEY_FILE": "/opt/zhudatuan/shared/tls/internal.key",
      "LOCAL_TLS_CERT_FILE": "/opt/zhudatuan/shared/tls/internal.crt",
      "LOCAL_SECRETS_FILE": "/opt/zhudatuan/shared/secrets.json",
      "LOCAL_SECRETS_PORT": "8543",
      "LOCAL_KMS_PORT": "8544",
      "LOCAL_KMS_MASTER_KEY": "{env:AUTONODE_ZHUDUATUAN_LOCAL_KMS_MASTER_KEY}",
      "LOCAL_KMS_BEARER_TOKEN": "{env:AUTONODE_ZHUDUATUAN_LOCAL_KMS_TOKEN}",
      "LOCAL_SECRET_STORE_BEARER_TOKEN": "{env:AUTONODE_ZHUDUATUAN_LOCAL_SECRET_STORE_TOKEN}",
      "LOCAL_OBJECTS_TOKEN": "{env:AUTONODE_ZHUDUATUAN_OBJECT_STORE_TOKEN}",
      "NODE_EXTRA_CA_CERTS": "/opt/zhudatuan/shared/tls/internal-ca.crt"
    }
  },
  "tls": {
    "binding_ref": "tls:zhudatuan-l0:new-store-origin",
    "certificate_file": "/opt/sfl/control/autonode/zhudatuan-l0-tls/origin.crt",
    "private_key_file": "/opt/sfl/control/autonode/zhudatuan-l0-tls/origin.key",
    "ca_file": "/opt/sfl/control/autonode/zhudatuan-l0-tls/origin-ca.crt"
  },
  "cloudflare": {
    "account_id": "4dceba8f9d03d121208467416a73c948",
    "api_token_env": "AUTONODE_ZHUDUATUAN_CLOUDFLARE_TOKEN"
  },
  "identity_registry": {
    "binding_ref": "identity-registry:zhudatuan-l0",
    "connection_string_env": "AUTONODE_ZHUDUATUAN_IDENTITY_DATABASE_URL"
  },
  "commands": {}
}
